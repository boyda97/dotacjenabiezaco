{
  "name": "dotacjenabiezaco-konta-platnosci",
  "version": "0.1.0",
  "private": true,
  "description": "Dotacje na Bieżąco: konta (logowanie linkiem z e-maila), subskrypcje Stripe i tygodniowy dostęp jednorazowy",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\"",
    "setup:stripe": "node scripts/setup-stripe.js",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/stripe/webhook"
  },
  "dependencies": {
    "express": "^5.3.0",
    "stripe": "^23.0.1"
  }
}
