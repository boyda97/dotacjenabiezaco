NODE_ENV=production
PORT=3000
APP_URL=https://dotacjo.pl
DB_PATH=./data/dotacjo.db

# E-mail z linkiem logowania (https://resend.com). Puste = link tylko w logach (dev).
RESEND_API_KEY=
MAIL_FROM=Dotacjo <logowanie@dotacjo.pl>

# Alerty e-mail dla abonentów (nowe nabory + kończące się ulubione): raz w tygodniu, dzień 1 = poniedziałek,
# od tej godziny czasu polskiego; ALERTS_HOUR=0 wyłącza.
ALERTS_WEEKDAY=1
ALERTS_HOUR=7
ALERTS_FROM=Dotacjo <alerty@dotacjo.pl>

# Kto widzi statystyki na /admin (e-maile kont, po przecinku).
ADMIN_EMAILS=

# AI czyta ogłoszenia i regulaminy naborów (dotacjomat update --ai). Puste = tylko heurystyka.
# Ustaw miesięczny limit wydatków w console.anthropic.com.
ANTHROPIC_API_KEY=

# Dane firmy po NIP z GUS REGON (klucz: wniosek na regon_bir@stat.gov.pl). Puste = tylko Biała Lista MF.
GUS_KEY=

# Reklamy i analityka. Puste = brak banera cookies i żadnych skryptów zewnętrznych.
# GA_ID=G-XXXXXXX, GOOGLE_ADS_ID=AW-XXXXXXX, GOOGLE_ADS_PURCHASE_LABEL=etykieta konwersji „zakup”,
# META_PIXEL_ID=numer piksela z Meta Events Manager.
GA_ID=
GOOGLE_ADS_ID=
GOOGLE_ADS_PURCHASE_LABEL=
META_PIXEL_ID=

# Stripe: Dashboard -> Developers -> API keys / Webhooks
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Zwolnienie z VAT: zostaw 0. Po rejestracji do VAT: 1 = VAT liczony przez Stripe Tax (wymaga włączenia w panelu)
STRIPE_AUTOMATIC_TAX=0
# Stopka faktur (podstawa zwolnienia z VAT). Pusta wartość = brak stopki.
INVOICE_FOOTER=Sprzedawca zwolniony z VAT na podstawie art. 113 ust. 1 ustawy o VAT.

# Wynik `npm run setup:stripe`
STRIPE_PRICE_START=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BIURO=price_...
STRIPE_PRICE_WEEK=price_...

# Dostęp tygodniowy: zakres funkcji (start|pro|biuro) i długość
WEEK_PASS_PLAN=pro
WEEK_PASS_DAYS=7
PAST_DUE_GRACE_DAYS=3
